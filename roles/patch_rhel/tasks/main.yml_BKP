- name: Apply patches
  yum:
    name: '*'
    state: latest
  register: patch_result

- name: Fail if patch failed
  fail:
    msg: "RHEL patching failed"
  when: patch_result.failed

- name: Check reboot requirement
  command: needs-restarting -r
  register: reboot_flag
  failed_when: false

- name: Reboot if needed
  reboot:
    reboot_timeout: 600
  when: reboot_flag.rc != 0

- name: Wait for system
  wait_for_connection:
    timeout: 300
